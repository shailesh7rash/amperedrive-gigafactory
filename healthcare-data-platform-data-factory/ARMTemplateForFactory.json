{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "healthcare-data-platform-data-factory"
		},
		"LS_ADF_to_ADLS_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://healthcaredataplatstoacc.dfs.core.windows.net/"
		},
		"LS_ADF_to_AzureKeyVault_properties_typeProperties_baseUrl": {
			"type": "string",
			"defaultValue": "https://healthcare-dp-key-vault.vault.azure.net/"
		},
		"LS_ADF_to_AzureSqlDB_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "healthcare-data-platform-server.database.windows.net"
		},
		"LS_ADF_to_AzureSqlDB_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "healthcare-data-platform-sql-db"
		},
		"LS_ADF_to_AzureSqlDB_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "hcp-sql-db-user"
		},
		"LS_ADF_to_NeonPostgreSQL_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "ep-fragrant-smoke-b328e4fm-pooler.c-4.ap-southeast-1.aws.neon.tech"
		},
		"LS_ADF_to_NeonPostgreSQL_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "neondb"
		},
		"LS_ADF_to_NeonPostgreSQL_properties_typeProperties_username": {
			"type": "string",
			"defaultValue": "neondb_owner"
		},
		"LS_ADF_to_AzureDatabricks_properties_typeProperties_existingClusterId": {
			"type": "string",
			"defaultValue": "1027-083815-3wtriahn"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "[concat(parameters('factoryName'), '/PL_SOURCE_TO_SILVER_Inner')]",
			"type": "Microsoft.DataFactory/factories/pipelines",
			"apiVersion": "2018-06-01",
			"properties": {
				"activities": [
					{
						"name": "Read Source MTDT Table details",
						"type": "Lookup",
						"dependsOn": [],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 2,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"source": {
								"type": "AzureSqlSource",
								"sqlReaderQuery": {
									"value": "SELECT * FROM adg.etl_source_metadata WHERE table_id = @{pipeline().parameters.table_id}",
									"type": "Expression"
								},
								"queryTimeout": "02:00:00",
								"partitionOption": "None"
							},
							"dataset": {
								"referenceName": "DS_AzureSql",
								"type": "DatasetReference",
								"parameters": {}
							},
							"firstRowOnly": true
						}
					},
					{
						"name": "Set Current Timestamp",
						"type": "SetVariable",
						"dependsOn": [],
						"policy": {
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"variableName": "current_start_time",
							"value": {
								"value": "@formatDateTime(utcNow(), 'yyyy-MM-dd_hh:mm:ss')",
								"type": "Expression"
							}
						}
					},
					{
						"name": "Source_to_Landing Ingestion",
						"type": "Copy",
						"dependsOn": [
							{
								"activity": "Read Source MTDT Table details",
								"dependencyConditions": [
									"Succeeded"
								]
							},
							{
								"activity": "Set Current Timestamp",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"source": {
								"type": "PostgreSqlV2Source",
								"query": {
									"value": "SELECT * FROM public.@{activity('Read Source MTDT Table details').output.firstRow.source_path_or_table}",
									"type": "Expression"
								},
								"queryTimeout": "02:00:00"
							},
							"sink": {
								"type": "ParquetSink",
								"storeSettings": {
									"type": "AzureBlobFSWriteSettings"
								},
								"formatSettings": {
									"type": "ParquetWriteSettings"
								}
							},
							"enableStaging": false,
							"translator": {
								"type": "TabularTranslator",
								"typeConversion": true,
								"typeConversionSettings": {
									"allowDataTruncation": true,
									"treatBooleanAsNumber": false
								}
							}
						},
						"inputs": [
							{
								"referenceName": "DS_PostgreSql",
								"type": "DatasetReference",
								"parameters": {}
							}
						],
						"outputs": [
							{
								"referenceName": "DS_Postgre_to_ADLS_Sink_Parquet",
								"type": "DatasetReference",
								"parameters": {
									"container": "landingadg",
									"folder": {
										"value": "@concat(\n    activity('Read Source MTDT Table details').output.firstRow.source_system,\n    '/',\n    activity('Read Source MTDT Table details').output.firstRow.source_path_or_table,\n    '/',\n    variables('current_start_time')\n)",
										"type": "Expression"
									}
								}
							}
						]
					},
					{
						"name": "Landing_to_Bronze",
						"type": "DatabricksNotebook",
						"dependsOn": [
							{
								"activity": "Source_to_Landing Ingestion",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"notebookPath": "/amperedrive-gigafactory/amperedrive-gigafactory/databricks/Landing_to_Bronze",
							"baseParameters": {
								"source_system": {
									"value": "@activity('Read Source MTDT Table details').output.firstRow.source_system",
									"type": "Expression"
								},
								"source_path_or_table": {
									"value": "@activity('Read Source MTDT Table details').output.firstRow.source_path_or_table",
									"type": "Expression"
								},
								"landing_timestamp": {
									"value": "@variables('current_start_time')",
									"type": "Expression"
								}
							}
						},
						"linkedServiceName": {
							"referenceName": "LS_ADF_to_AzureDatabricks",
							"type": "LinkedServiceReference"
						}
					},
					{
						"name": "Bronze_to_Silver",
						"type": "DatabricksNotebook",
						"dependsOn": [
							{
								"activity": "Landing_to_Bronze",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"notebookPath": "/amperedrive-gigafactory/amperedrive-gigafactory/databricks/Bronze_to_Silver",
							"baseParameters": {
								"bronze_table_name": {
									"value": "@activity('Read Source MTDT Table details').output.firstRow.source_path_or_table",
									"type": "Expression"
								},
								"target_table_name": {
									"value": "@activity('Read Source MTDT Table details').output.firstRow.target_table_name",
									"type": "Expression"
								},
								"landing_timestamp": {
									"value": "@variables('current_start_time')",
									"type": "Expression"
								}
							}
						},
						"linkedServiceName": {
							"referenceName": "LS_ADF_to_AzureDatabricks",
							"type": "LinkedServiceReference"
						}
					},
					{
						"name": "Update Success status",
						"type": "Script",
						"dependsOn": [
							{
								"activity": "Bronze_to_Silver",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 2,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"linkedServiceName": {
							"referenceName": "LS_ADF_to_AzureSqlDB",
							"type": "LinkedServiceReference"
						},
						"typeProperties": {
							"scripts": [
								{
									"type": "Query",
									"text": {
										"value": "UPDATE adg.etl_pipeline_execution_log\nSET status = 'SUCCESS', watermark_end = SYSUTCDATETIME(), rows_extracted = @{activity('Bronze_to_Silver').output.runOutput.rows_extracted}, rows_loaded = @{activity('Bronze_to_Silver').output.runOutput.rows_loaded}, rows_inserted = @{activity('Bronze_to_Silver').output.runOutput.rows_inserted}, rows_updated = @{activity('Bronze_to_Silver').output.runOutput.rows_updated}, completed_at = SYSUTCDATETIME()\nWHERE pipeline_name = '@{pipeline().parameters.pipeline_name}' AND table_id = @{pipeline().parameters.table_id}",
										"type": "Expression"
									}
								}
							],
							"scriptBlockExecutionTimeout": "02:00:00"
						}
					}
				],
				"policy": {
					"elapsedTimeMetric": {}
				},
				"parameters": {
					"table_id": {
						"type": "string",
						"defaultValue": "1"
					},
					"pipeline_name": {
						"type": "string",
						"defaultValue": "a1"
					}
				},
				"variables": {
					"current_start_time": {
						"type": "String"
					}
				},
				"annotations": []
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/datasets/DS_AzureSql')]",
				"[concat(variables('factoryId'), '/datasets/DS_PostgreSql')]",
				"[concat(variables('factoryId'), '/datasets/DS_Postgre_to_ADLS_Sink_Parquet')]",
				"[concat(variables('factoryId'), '/linkedServices/LS_ADF_to_AzureDatabricks')]",
				"[concat(variables('factoryId'), '/linkedServices/LS_ADF_to_AzureSqlDB')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/PL_SOURCE_TO_SILVER_Main')]",
			"type": "Microsoft.DataFactory/factories/pipelines",
			"apiVersion": "2018-06-01",
			"properties": {
				"activities": [
					{
						"name": "Read Source Metadata",
						"type": "Lookup",
						"dependsOn": [],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 2,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"source": {
								"type": "AzureSqlSource",
								"sqlReaderQuery": {
									"value": "SELECT table_id FROM adg.etl_source_metadata WHERE is_active = 1 and source_system = '@{pipeline().parameters.source_system}'",
									"type": "Expression"
								},
								"queryTimeout": "02:00:00",
								"partitionOption": "None"
							},
							"dataset": {
								"referenceName": "DS_AzureSql",
								"type": "DatasetReference",
								"parameters": {}
							},
							"firstRowOnly": false
						}
					},
					{
						"name": "Ingest All Tables",
						"type": "ForEach",
						"dependsOn": [
							{
								"activity": "Read Source Metadata",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"userProperties": [],
						"typeProperties": {
							"items": {
								"value": "@activity('Read Source Metadata').output.value",
								"type": "Expression"
							},
							"activities": [
								{
									"name": "Execute PL_Source_to_Bronze_Inner",
									"type": "ExecutePipeline",
									"dependsOn": [
										{
											"activity": "Insert Running status",
											"dependencyConditions": [
												"Succeeded"
											]
										}
									],
									"policy": {
										"secureInput": false
									},
									"userProperties": [],
									"typeProperties": {
										"pipeline": {
											"referenceName": "PL_SOURCE_TO_SILVER_Inner",
											"type": "PipelineReference"
										},
										"waitOnCompletion": true,
										"parameters": {
											"table_id": {
												"value": "@item().table_id",
												"type": "Expression"
											},
											"pipeline_name": {
												"value": "@pipeline().parameters.pipeline_name",
												"type": "Expression"
											}
										}
									}
								},
								{
									"name": "Insert Running status",
									"type": "Script",
									"dependsOn": [],
									"policy": {
										"timeout": "0.12:00:00",
										"retry": 2,
										"retryIntervalInSeconds": 30,
										"secureOutput": false,
										"secureInput": false
									},
									"userProperties": [],
									"linkedServiceName": {
										"referenceName": "LS_ADF_to_AzureSqlDB",
										"type": "LinkedServiceReference"
									},
									"typeProperties": {
										"scripts": [
											{
												"type": "Query",
												"text": {
													"value": "INSERT INTO adg.etl_pipeline_execution_log (table_id, pipeline_name, stage, status, started_at, watermark_start)\nVALUES\n(@{item().table_id}, '@{pipeline().parameters.pipeline_name}', 'SOURCE_TO_SILVER', 'RUNNING', SYSUTCDATETIME(), SYSUTCDATETIME())",
													"type": "Expression"
												}
											}
										],
										"scriptBlockExecutionTimeout": "02:00:00"
									}
								},
								{
									"name": "Update Failed status",
									"type": "Script",
									"dependsOn": [
										{
											"activity": "Execute PL_Source_to_Bronze_Inner",
											"dependencyConditions": [
												"Failed"
											]
										}
									],
									"policy": {
										"timeout": "0.12:00:00",
										"retry": 2,
										"retryIntervalInSeconds": 30,
										"secureOutput": false,
										"secureInput": false
									},
									"userProperties": [],
									"linkedServiceName": {
										"referenceName": "LS_ADF_to_AzureSqlDB",
										"type": "LinkedServiceReference"
									},
									"typeProperties": {
										"scripts": [
											{
												"type": "Query",
												"text": {
													"value": "UPDATE adg.etl_pipeline_execution_log\nSET status = 'FAILED', watermark_end = SYSUTCDATETIME()\nWHERE pipeline_name = '@{pipeline().parameters.pipeline_name}' AND table_id = @{item().table_id}",
													"type": "Expression"
												}
											}
										],
										"scriptBlockExecutionTimeout": "02:00:00"
									}
								}
							]
						}
					}
				],
				"policy": {
					"elapsedTimeMetric": {}
				},
				"parameters": {
					"source_system": {
						"type": "string",
						"defaultValue": "POSTGRES_NEON"
					},
					"pipeline_name": {
						"type": "string",
						"defaultValue": "'a2'"
					}
				},
				"variables": {
					"test": {
						"type": "String"
					}
				},
				"annotations": []
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/datasets/DS_AzureSql')]",
				"[concat(variables('factoryId'), '/pipelines/PL_SOURCE_TO_SILVER_Inner')]",
				"[concat(variables('factoryId'), '/linkedServices/LS_ADF_to_AzureSqlDB')]"
			]
		},

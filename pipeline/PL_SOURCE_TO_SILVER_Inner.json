{
	"name": "PL_SOURCE_TO_SILVER_Inner",
	"properties": {
		"activities": [
			{
				"name": "Read Source MTDT Table details",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 2,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": {
							"value": "SELECT * FROM adg.etl_source_metadata WHERE table_id = @{pipeline().parameters.table_id}",
							"type": "Expression"
						},
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "DS_AzureSql",
						"type": "DatasetReference"
					},
					"firstRowOnly": true
				}
			},
			{
				"name": "Set Current Timestamp",
				"type": "SetVariable",
				"dependsOn": [],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "current_start_time",
					"value": {
						"value": "@formatDateTime(utcNow(), 'yyyy-MM-dd_hh:mm:ss')",
						"type": "Expression"
					}
				}
			},
			{
				"name": "Source_to_Landing Ingestion",
				"type": "Copy",
				"dependsOn": [
					{
						"activity": "Check Load Type",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "PostgreSqlV2Source",
						"query": {
							"value": "SELECT * FROM public.@{activity('Read Source MTDT Table details').output.firstRow.source_path_or_table}\n@{\n    if(equals(activity('Read Source MTDT Table details').output.firstRow.load_type, 'FULL_OVERWRITE'),\n    '',\n    concat(' WHERE ', activity('Read Source MTDT Table details').output.firstRow.watermark_column, ' > ', '''', variables('last_watermark_value'), '''')\n    )\n}",
							"type": "Expression"
						},
						"queryTimeout": "02:00:00"
					},
					"sink": {
						"type": "ParquetSink",
						"storeSettings": {
							"type": "AzureBlobFSWriteSettings"
						},
						"formatSettings": {
							"type": "ParquetWriteSettings"
						}
					},
					"enableStaging": false,
					"translator": {
						"type": "TabularTranslator",
						"typeConversion": true,
						"typeConversionSettings": {
							"allowDataTruncation": true,
							"treatBooleanAsNumber": false
						}
					}
				},
				"inputs": [
					{
						"referenceName": "DS_PostgreSql",
						"type": "DatasetReference"
					}
				],
				"outputs": [
					{
						"referenceName": "DS_Postgre_to_ADLS_Sink_Parquet",
						"type": "DatasetReference",
						"parameters": {
							"container": "landingadg",
							"folder": {
								"value": "@concat(\n    activity('Read Source MTDT Table details').output.firstRow.source_system,\n    '/',\n    activity('Read Source MTDT Table details').output.firstRow.source_path_or_table,\n    '/',\n    variables('current_start_time')\n)",
								"type": "Expression"
							}
						}
					}
				]
			},
			{
				"name": "Landing_to_Bronze",
				"type": "DatabricksNotebook",
				"dependsOn": [
					{
						"activity": "Source_to_Landing Ingestion",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"notebookPath": "/amperedrive-gigafactory/amperedrive-gigafactory/databricks/Landing_to_Bronze",
					"baseParameters": {
						"source_system": {
							"value": "@activity('Read Source MTDT Table details').output.firstRow.source_system",
							"type": "Expression"
						},
						"source_path_or_table": {
							"value": "@activity('Read Source MTDT Table details').output.firstRow.source_path_or_table",
							"type": "Expression"
						},
						"landing_timestamp": {
							"value": "@variables('current_start_time')",
							"type": "Expression"
						}
					}
				},
				"linkedServiceName": {
					"referenceName": "LS_ADF_to_AzureDatabricks",
					"type": "LinkedServiceReference"
				}
			},
			{
				"name": "Bronze_to_Silver",
				"type": "DatabricksNotebook",
				"dependsOn": [
					{
						"activity": "Landing_to_Bronze",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"notebookPath": "/amperedrive-gigafactory/amperedrive-gigafactory/databricks/Bronze_to_Silver",
					"baseParameters": {
						"bronze_table_name": {
							"value": "@activity('Read Source MTDT Table details').output.firstRow.source_path_or_table",
							"type": "Expression"
						},
						"target_table_name": {
							"value": "@activity('Read Source MTDT Table details').output.firstRow.target_table_name",
							"type": "Expression"
						},
						"landing_timestamp": {
							"value": "@variables('current_start_time')",
							"type": "Expression"
						},
						"load_type": {
							"value": "@activity('Read Source MTDT Table details').output.firstRow.load_type",
							"type": "Expression"
						},
						"merge_key": {
							"value": "@coalesce(activity('Read Source MTDT Table details').output.firstRow.merge_key, '')",
							"type": "Expression"
						},
						"scd_type": {
							"value": "@string(coalesce(activity('Read Source MTDT Table details').output.firstRow.scd_type, ''))",
							"type": "Expression"
						}
					}
				},
				"linkedServiceName": {
					"referenceName": "LS_ADF_to_AzureDatabricks",
					"type": "LinkedServiceReference"
				}
			},
			{
				"name": "Update Success status",
				"type": "Script",
				"dependsOn": [
					{
						"activity": "Bronze_to_Silver",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 2,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"linkedServiceName": {
					"referenceName": "LS_ADF_to_AzureSqlDB",
					"type": "LinkedServiceReference"
				},
				"typeProperties": {
					"scripts": [
						{
							"type": "Query",
							"text": {
								"value": "UPDATE adg.etl_pipeline_execution_log\nSET status = 'SUCCESS', watermark_end = SYSUTCDATETIME(), rows_extracted = @{activity('Bronze_to_Silver').output.runOutput.rows_extracted}, rows_loaded = @{activity('Bronze_to_Silver').output.runOutput.rows_loaded}, rows_inserted = @{activity('Bronze_to_Silver').output.runOutput.rows_inserted}, rows_updated = @{activity('Bronze_to_Silver').output.runOutput.rows_updated}, completed_at = SYSUTCDATETIME()\nWHERE pipeline_name = '@{pipeline().parameters.pipeline_name}' AND table_id = @{pipeline().parameters.table_id}",
								"type": "Expression"
							}
						}
					],
					"scriptBlockExecutionTimeout": "02:00:00"
				}
			},
			{
				"name": "Check Load Type",
				"type": "IfCondition",
				"dependsOn": [
					{
						"activity": "Read Source MTDT Table details",
						"dependencyConditions": [
							"Succeeded"
						]
					},
					{
						"activity": "Set Current Timestamp",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"expression": {
						"value": "@not(equals(activity('Read Source MTDT Table details').output.firstRow.load_type, 'FULL_OVERWRITE'))",
						"type": "Expression"
					},
					"ifTrueActivities": [
						{
							"name": "Read watermark for merge and append load",
							"type": "Lookup",
							"dependsOn": [],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"source": {
									"type": "AzureSqlSource",
									"sqlReaderQuery": {
										"value": "SELECT last_watermark_value FROM adg.etl_pipeline_watermarks WHERE table_id = @{pipeline().parameters.table_id}",
										"type": "Expression"
									},
									"queryTimeout": "02:00:00",
									"partitionOption": "None"
								},
								"dataset": {
									"referenceName": "DS_AzureSql",
									"type": "DatasetReference"
								}
							}
						},
						{
							"name": "Watermark value for Merge Append",
							"type": "SetVariable",
							"dependsOn": [
								{
									"activity": "Read watermark for merge and append load",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"variableName": "last_watermark_value",
								"value": {
									"value": "@activity('Read watermark for merge and append load').output.firstRow.last_watermark_value",
									"type": "Expression"
								}
							}
						}
					]
				}
			},
			{
				"name": "Check Load Type for Watermark update",
				"type": "IfCondition",
				"dependsOn": [
					{
						"activity": "Bronze_to_Silver",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"expression": {
						"value": "@not(equals(activity('Read Source MTDT Table details').output.firstRow.load_type, 'FULL_OVERWRITE'))",
						"type": "Expression"
					},
					"ifTrueActivities": [
						{
							"name": "Update Watermark on Success",
							"type": "Script",
							"dependsOn": [],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"linkedServiceName": {
								"referenceName": "LS_ADF_to_AzureSqlDB",
								"type": "LinkedServiceReference"
							},
							"typeProperties": {
								"scripts": [
									{
										"type": "Query",
										"text": {
											"value": "UPDATE adg.etl_pipeline_watermarks\nSET last_watermark_value = SYSUTCDATETIME()\nWHERE table_id = @{pipeline().parameters.table_id}",
											"type": "Expression"
										}
									}
								],
								"scriptBlockExecutionTimeout": "02:00:00"
							}
						}
					]
				}
			}
		],
		"parameters": {
			"table_id": {
				"type": "string",
				"defaultValue": "1"
			},
			"pipeline_name": {
				"type": "string",
				"defaultValue": "a1"
			}
		},
		"variables": {
			"current_start_time": {
				"type": "String"
			},
			"last_watermark_value": {
				"type": "String"
			}
		},
		"annotations": []
	}
}